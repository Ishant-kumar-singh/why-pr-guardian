# GitHub
# A classic or OAuth token with public_repo scope. Raises the API rate limit from
# 60 to 5000 requests/hour, which ingestion depends on.
GITHUB_TOKEN=ghp_your_token_here

# LLM (any OpenAI-compatible endpoint)
# Defaults target a local OmniRoute gateway. Point these at OpenAI, OpenRouter,
# vLLM, LM Studio, Ollama, etc. -- only these three variables change.
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=not-needed-for-local-gateway
# No default. The app fails loudly if this is unset.
LLM_MODEL=auto/fast

# Repo to ingest (owner/name). Defaults to psf/requests.
REPO=psf/requests

# A repo you own, used for guardian demos. The guardian will only ever write here.
GUARD_REPO=Ishant-kumar-singh/requests

# When true the guardian prints/returns actions instead of sending them.
DRY_RUN=true

# Automatically publish Guardian comments and request reviewers after a check.
# The Guardian UI can still post a drafted comment manually when DRY_RUN=false.
AUTO_POST=false

# How many recent merged PRs to ingest.
MAX_PRS=150

# FalkorDB connection
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH=why
# Host port exposed by docker compose; if 6379 is occupied, change this and
# FALKORDB_PORT to the same available port. Change the UI host port if 3000 is busy.
FALKORDB_HOST_PORT=6379
FALKORDB_UI_HOST_PORT=3000

# Optional: full-text weighted search fallback tuning
HTTP_TIMEOUT=30
